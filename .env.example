# Documentation only. The app reads process environment; it does not load .env.
# For Docker Compose, copy locally to .env and enter values securely, never commit.
REWARDS_DATABASE=.data/rewards.sqlite
REWARDS_MEDIA_ROOT=.data/media
REWARDS_LIVE_PUBLISHING=false
# Configure a strong private token for authenticated API access. CLI works without it.
REWARDS_ADMIN_TOKEN=
# Optional manual short-lived token; the owner cloud PKCE flow requests only bounty:basic.
# Current list endpoint documents bounty:basic:read; never widen consent implicitly.
WHOP_ACCESS_TOKEN=
# Preferred persistent authorization: deployed owner-operated HTTPS Workers origin.
WHOP_BROKER_URL=
# Secure separate broker API credential; never a Whop token or callback code.
WHOP_BROKER_API_TOKEN=
# OAuth account owner authorization required; access tokens expire.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
# Optional offline Google OAuth renewal for unattended operation.
# Client ID is non-secret; the following token/secret belong in secure settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Confirm a currently supported version in your Meta app; no assumed default.
INSTAGRAM_API_VERSION=
# Only configure after confirming your hosting serves immutable content-addressed MP4s.
INSTAGRAM_IMMUTABLE_MEDIA_HOST=
